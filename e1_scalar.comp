#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) readonly buffer A { float a[]; };
layout(std430, binding = 1) readonly buffer B { float b[]; };
layout(std430, binding = 2) buffer C { float c[]; };
layout(constant_id = 0) const int K_ = 0;
layout(constant_id = 1) const int N_ = 0;
void main() {
    int r0 = int(gl_WorkGroupID.x) * 64 + int(gl_LocalInvocationID.x) * 8;
    int c0 = int(gl_WorkGroupID.y) * 64 + int(gl_LocalInvocationID.y) * 8;
    float16_t acc[8][8];
    for (int i = 0; i < 8; i++)
        for (int j = 0; j < 8; j++) acc[i][j] = 0.0hf;
    for (int kk = 0; kk < K_; kk++)
        for (int i = 0; i < 8; i++)
            for (int j = 0; j < 8; j++)
                acc[i][j] += float16_t(a[(r0 + i) * K_ + kk]) * float16_t(b[kk * N_ + c0 + j]);
    for (int i = 0; i < 8; i++)
        for (int j = 0; j < 8; j++)
            c[(r0 + i) * N_ + c0 + j] = float(acc[i][j]);
}
