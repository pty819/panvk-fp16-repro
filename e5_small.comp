#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) readonly buffer A { float a[]; };
layout(std430, binding = 1) readonly buffer B { float b[]; };
layout(std430, binding = 2) buffer C { float c[]; };
layout(constant_id = 0) const int K_ = 0;
layout(constant_id = 1) const int N_ = 0;
void main() {
    int r0 = int(gl_WorkGroupID.x) * 32 + int(gl_LocalInvocationID.x) * 4;
    int c0 = int(gl_WorkGroupID.y) * 32 + int(gl_LocalInvocationID.y) * 4;
    f16vec2 acc[4][2];
    for (int i = 0; i < 4; i++)
        for (int j = 0; j < 2; j++) acc[i][j] = f16vec2(0.0hf);
    for (int kt = 0; kt < K_; kt += 8) {
        f16vec2 af[4][8];
        for (int i = 0; i < 4; i++)
            for (int kk = 0; kk < 8; kk++)
                af[i][kk] = f16vec2(a[(r0 + i) * K_ + kt + kk]);
        f16vec2 bf[8][2];
        for (int kk = 0; kk < 8; kk++)
            for (int j = 0; j < 2; j++)
                bf[kk][j] = f16vec2(b[(kt + kk) * N_ + c0 + 2 * j], b[(kt + kk) * N_ + c0 + 2 * j + 1]);
        for (int kk = 0; kk < 8; kk++)
            for (int i = 0; i < 4; i++)
                for (int j = 0; j < 2; j++)
                    acc[i][j] += af[i][kk] * bf[kk][j];
    }
    for (int i = 0; i < 4; i++)
        for (int j = 0; j < 2; j++) {
            c[(r0 + i) * N_ + c0 + 2 * j] = float(acc[i][j].x);
            c[(r0 + i) * N_ + c0 + 2 * j + 1] = float(acc[i][j].y);
        }
}
