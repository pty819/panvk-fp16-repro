#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) readonly buffer A { float a[]; };
layout(std430, binding = 1) readonly buffer B { float b[]; };
layout(std430, binding = 2) buffer C { float c[]; };
layout(std430, binding = 3) buffer D { float d[]; };
layout(constant_id = 0) const int K_ = 0;
layout(constant_id = 1) const int N_ = 0;
shared float16_t sa[64][8][8];
void main() {
    int r0 = int(gl_WorkGroupID.x) * 64 + int(gl_LocalInvocationID.x) * 8;
    int c0 = int(gl_WorkGroupID.y) * 64 + int(gl_LocalInvocationID.y) * 8;
    int tid = int(gl_LocalInvocationIndex);
    f16vec2 acc[8][4];
    for (int i = 0; i < 8; i++)
        for (int j = 0; j < 4; j++) acc[i][j] = f16vec2(0.0hf);
    float16_t chk = 0.0hf;
    for (int kt = 0; kt < K_; kt += 8) {
        for (int i = 0; i < 8; i++)
            for (int kk = 0; kk < 8; kk++)
                sa[tid][i][kk] = float16_t(a[(r0 + i) * K_ + kt + kk]);
        barrier();
        f16vec2 af[8][8];
        for (int i = 0; i < 8; i++)
            for (int kk = 0; kk < 8; kk++)
                af[i][kk] = f16vec2(sa[tid][i][kk]);
        f16vec2 bf[8][4];
        for (int kk = 0; kk < 8; kk++)
            for (int j = 0; j < 4; j++)
                bf[kk][j] = f16vec2(b[(kt + kk) * N_ + c0 + 2 * j], b[(kt + kk) * N_ + c0 + 2 * j + 1]);
        for (int i = 0; i < 8; i++)
            for (int kk = 0; kk < 8; kk++)
                chk += af[i][kk].x + af[i][kk].y;
        for (int kk = 0; kk < 8; kk++)
            for (int i = 0; i < 8; i++)
                for (int j = 0; j < 4; j++)
                    acc[i][j] += af[i][kk] * bf[kk][j];
    }
    for (int i = 0; i < 8; i++)
        for (int j = 0; j < 4; j++) {
            c[(r0 + i) * N_ + c0 + 2 * j] = float(acc[i][j].x);
            c[(r0 + i) * N_ + c0 + 2 * j + 1] = float(acc[i][j].y);
        }
    d[tid] = float(chk);
}
